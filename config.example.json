{
  "codeHost": {
    "provider": "github",
    "org": "acme",
    "repos": ["orders-api", "orders-web"],
    "excludeRepos": [],
    "teams": ["platform-team"],
    "localRepos": []
  },
  "reviewerClasses": {
    "ai-review": ["copilot-pull-request-reviewer"],
    "code-analysis": ["codescene-access", "codescene-delta-analysis"]
  },
  "refreshIntervalSec": 180,
  "issueTracker": {
    "provider": "jira",
    "baseUrl": "https://jira.example.com",
    "expectedStatuses": { "open": ["In Review"], "merged": ["Ready for Test", "Done"] }
  },
  "notifications": {
    "enabled": true,
    "events": { "reviewRequested": true }
  }
}
