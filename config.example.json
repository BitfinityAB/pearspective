{
  "codeHost": {
    "provider": "github",
    "org": "acme",
    "repos": ["orders-api", "orders-web"],
    "excludeRepos": [],
    "teams": ["platform-team"],
    "localRepos": []
  },
  "reviewers": {
    "aiReview": { "name": "Copilot", "logins": ["copilot-pull-request-reviewer"] },
    "codeAnalysis": { "name": "CodeScene", "logins": ["codescene-*"] }
  },
  "refreshIntervalSec": 180,
  "issueTracker": {
    "provider": "jira",
    "baseUrl": "https://jira.example.com",
    "expectedStatuses": { "open": ["In Review"], "merged": ["Ready for Test", "Done"] }
  },
  "notifications": {
    "enabled": true,
    "events": { "reviewRequested": true }
  }
}
